# Teritory Standalone Backend Environment
NODE_ENV=development
PORT=4000

# Neon PostgreSQL Database
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.aws.neon.tech/teritory_db?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your_refresh_secret_key"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis Cache (Optional - auto falls back to in-memory store)
REDIS_URL=

# App Specific Configs
WAYPOINT_VALIDATION_RADIUS_METERS=15000
RALLY_ARRIVAL_RADIUS_METERS=500
SUB_TERITORY_RADIUS_METERS=5000

